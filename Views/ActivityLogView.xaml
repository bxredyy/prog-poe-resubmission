<UserControl x:Class="CyberSecurityBot.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CyberSecurityBot.Models"
             Background="Transparent">
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource HeadingText}" Text="Activity Log"/>
                <TextBlock x:Name="LimitText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,8"/>
            </StackPanel>

            <ListBox Grid.Row="1"
                     x:Name="EntryList"
                     BorderThickness="0"
                     Background="Transparent">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="0,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ActivityLogEntry}">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="  ·  " Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Style="{StaticResource MutedText}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ShowMoreButton"
                        Content="Show All"
                        Style="{StaticResource GhostButton}"
                        Click="ShowMore_Click"/>
                <Button x:Name="ShowRecentButton"
                        Content="Show Recent"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        IsEnabled="False"
                        Click="ShowRecent_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
