<UserControl x:Class="CyberSecurityBot.Views.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CyberSecurityBot.Models"
             Background="Transparent">
    <Grid Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Style="{StaticResource HeadingText}" Text="Add a cybersecurity task"/>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="e.g. 'Enable two-factor authentication on email'"
                           Margin="0,0,0,12"/>

                <TextBlock Text="Title" Margin="0,4,0,4"/>
                <TextBox x:Name="TitleBox"/>

                <TextBlock Text="Description (optional)" Margin="0,12,0,4"/>
                <TextBox x:Name="DescriptionBox"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="80"
                         VerticalScrollBarVisibility="Auto"/>

                <TextBlock Text="Reminder date (optional)" Margin="0,12,0,4"/>
                <DatePicker x:Name="ReminderPicker"/>

                <Button Margin="0,16,0,0" Content="Add Task" Click="AddTask_Click"/>
                <TextBlock x:Name="StatusLabel"
                           Style="{StaticResource MutedText}"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource HeadingText}" Text="Your tasks"/>
                    <TextBlock x:Name="DbStatusText"
                               Style="{StaticResource MutedText}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,8"/>
                </StackPanel>

                <ListView Grid.Row="1"
                          x:Name="TaskList"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CyberTask}">
                            <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="  ·  " Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding ReminderLabel}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Done"
                                                Style="{StaticResource GhostButton}"
                                                Click="MarkDone_Click"
                                                Tag="{Binding}"
                                                Margin="0,0,6,0"/>
                                        <Button Content="Delete"
                                                Style="{StaticResource DangerButton}"
                                                Click="Delete_Click"
                                                Tag="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
