<Window x:Class="CyberSecurityBot.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CyberSecurityBot.Views"
        Title="Cybersecurity Awareness Bot"
        Height="780" Width="1180"
        MinHeight="640" MinWidth="940"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="BannerText"
                           Grid.Column="0"
                           Style="{StaticResource AsciiBanner}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cybersecurity Awareness Bot"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentAltBrush}"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Your guide to staying safe online."
                               Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="ReplayVoiceButton"
                        Grid.Column="2"
                        Style="{StaticResource GhostButton}"
                        Content="Play Greeting"
                        VerticalAlignment="Center"
                        Click="ReplayVoiceButton_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16,12,16,0">
            <TabItem Header="Chat">
                <views:ChatView x:Name="ChatPage"/>
            </TabItem>
            <TabItem Header="Tasks">
                <views:TaskView x:Name="TaskPage"/>
            </TabItem>
            <TabItem Header="Quiz">
                <views:QuizView x:Name="QuizPage"/>
            </TabItem>
            <TabItem Header="Activity Log">
                <views:ActivityLogView x:Name="LogPage"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" Padding="24,8">
            <TextBlock x:Name="StatusText"
                       Text="Ready."
                       Style="{StaticResource MutedText}"/>
        </Border>
    </Grid>
</Window>
