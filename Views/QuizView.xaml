<UserControl x:Class="CyberSecurityBot.Views.QuizView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource HeadingText}" Text="Cybersecurity Quiz"/>
                <TextBlock x:Name="ProgressText" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="12,0,0,8"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="QuestionText"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,8,0,12"/>

            <StackPanel Grid.Row="2" x:Name="OptionsPanel"/>

            <TextBlock Grid.Row="3"
                       x:Name="FeedbackText"
                       Style="{StaticResource MutedText}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="StartButton" Content="Start Quiz" Click="StartButton_Click"/>
                <Button x:Name="NextButton"
                        Content="Next Question"
                        Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}"
                        IsEnabled="False"
                        Click="NextButton_Click"/>
                <TextBlock x:Name="ScoreText"
                           Style="{StaticResource MutedText}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
